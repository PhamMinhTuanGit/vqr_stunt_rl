#!/usr/bin/env bash
set -euo pipefail

export PYTHONPATH="@VQR_CASADI_PYTHON_PATH@:@VQR_PINOCCHIO_PYTHON_PATH@${PYTHONPATH:+:$PYTHONPATH}"
export VQR_TREAD_CONTACT_LIBRARY="@CMAKE_CURRENT_BINARY_DIR@/libtread_contact_c_api.so"
export VQR_CONFIG_PATH="@VQR_EQUILIBRIUM_CONFIG_PATH@"
export VQR_URDF_PATH="@VQR_URDF_PATH@"
export VQR_OUTPUT_PATH="@VQR_KINEMATIC_OUTPUT_PATH@"

exec "@VQR_PYTHON_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/apps/kinematic_equilibrium.py" "$@"
